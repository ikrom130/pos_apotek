              "mode": "raw",
              "raw": "{\n  \"employee_name\": \"Pegawai Uji {{runId}}\",\n  \"employee_role\": \"kasir\",\n  \"employee_phone\": \"081234567890\",\n  \"employee_username\": \"{{employeeUsername}}\",\n  \"employee_password\": \"{{employeeInitialPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/employees/create.php"
          },
          "event": [
