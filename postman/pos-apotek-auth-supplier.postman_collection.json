              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/refresh.php"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Refresh sukses', function () { pm.expect(body.status).to.eql('success'); pm.expect(body.csrf_token).to.be.a('string').and.not.empty; });",
                  "pm.environment.set('csrfToken', body.csrf_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "01.5 Periksa sesi setelah refresh",
          "request": {
            "method": "GET",
            "header": [],
