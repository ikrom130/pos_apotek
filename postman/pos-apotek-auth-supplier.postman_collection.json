{
  "info": {
    "_postman_id": "fb9af867-3434-4d04-a132-2092e13c1b3c",
    "name": "POS Apotek - Auth, Employees, Suppliers",
    "description": "Pengujian HTTP lokal terbatas pada endpoint auth, employees, dan suppliers. Jalankan berurutan (Run collection) dengan database development khusus. Collection membuat satu pegawai uji dan satu supplier uji; endpoint delete tidak tersedia.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Login admin dan sesi",
      "item": [
        {
          "name": "01.1 Ambil token CSRF",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/csrf-token.php"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('csrf_token tersedia', function () { pm.expect(body.csrf_token).to.be.a('string').and.not.empty; });",
                  "pm.environment.set('csrfToken', body.csrf_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "01.2 Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{appOrigin}}"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login-process.php"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Login admin berhasil', function () { pm.expect(body.status).to.eql('success'); pm.expect(body.employee.employee_role).to.eql('admin'); });",
                  "pm.environment.set('csrfToken', body.csrf_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "01.3 Periksa sesi admin",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me.php"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Profil admin tersedia', function () { pm.expect(pm.response.json().employee.employee_role).to.eql('admin'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "01.4 Refresh sesi",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
