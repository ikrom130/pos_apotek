              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = Date.now().toString();",
                  "pm.environment.set('runId', id);",
                  "pm.environment.set('employeeUsername', 'pm.' + id);",
                  "pm.environment.set('employeeInitialPassword', 'AwalPegawai' + id + '!');",
                  "pm.environment.set('employeeResetPassword', 'ResetPegawai' + id + '!');"
                ]
