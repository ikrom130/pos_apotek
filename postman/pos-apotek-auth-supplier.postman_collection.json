            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('Employee dibuat dengan ID server-side', function () { pm.expect(body.status).to.eql('success'); pm.expect(body.employee_id).to.match(/^EMP-[0-9]{5,11}$/); });",
                  "pm.environment.set('employeeId', body.employee_id);"
