digraph ERD {
graph [rankdir=LR, splines=ortho, overlap=false, nodesep=0.42, ranksep=1.0, pad=0.25, bgcolor="white", fontname="Arial", label="ERD POS Apotek — pos_stagging.sql", labelloc=t, fontsize=22];
node [shape=plain, fontname="Arial", fontsize=10];
edge [color="#667085", penwidth=1.25, arrowsize=0.75, fontname="Arial", fontsize=8];
"employees" [label=<<TABLE BORDER="1" COLOR="#98A2B3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD BGCOLOR="#E8F1FF" ALIGN="LEFT" CELLPADDING="6"><B>employees</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">employee_id <FONT COLOR="#667085">: varchar(15)</FONT> <FONT COLOR="#B42318"><B>[PK]</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">employee_name <FONT COLOR="#667085">: varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">employee_role <FONT COLOR="#667085">: varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">employee_phone <FONT COLOR="#667085">: varchar(15)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">employee_username <FONT COLOR="#667085">: varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">employee_password <FONT COLOR="#667085">: varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">created_at <FONT COLOR="#667085">: timestamp</FONT></TD></TR></TABLE>>];
