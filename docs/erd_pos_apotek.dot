"products" [label=<<TABLE BORDER="1" COLOR="#98A2B3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD BGCOLOR="#D9EAD3" ALIGN="LEFT" CELLPADDING="6"><B>products</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">product_id <FONT COLOR="#667085">: varchar(15)</FONT> <FONT COLOR="#B42318"><B>[PK]</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">product_name <FONT COLOR="#667085">: varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">form_id <FONT COLOR="#667085">: int</FONT> <FONT COLOR="#B42318"><B>[FK]</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">product_type <FONT COLOR="#667085">: enum(&#x27;Medicine&#x27;,&#x27;Medical Equipment&#x27;,&#x27;General/Cosmetic&#x27;)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">product_group <FONT COLOR="#667085">: enum(&#x27;Obat Bebas&#x27;,&#x27;Obat Bebas Terbatas&#x27;,&#x27;Obat Keras&#x27;,&#x27;Narkotika&#x27;,&#x27;Psikotropika&#x27;,&#x27;Non-Obat&#x27;)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">min_stock_product <FONT COLOR="#667085">: int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">created_at <FONT COLOR="#667085">: timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">updated_at <FONT COLOR="#667085">: timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">created_by <FONT COLOR="#667085">: varchar(15)</FONT> <FONT COLOR="#B42318"><B>[FK]</B></FONT></TD></TR></TABLE>>];
