"purchasing_details" [label=<<TABLE BORDER="1" COLOR="#98A2B3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD BGCOLOR="#FCE4D6" ALIGN="LEFT" CELLPADDING="6"><B>purchasing_details</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">idx_no <FONT COLOR="#667085">: int</FONT> <FONT COLOR="#B42318"><B>[PK]</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">purchasing_id <FONT COLOR="#667085">: varchar(15)</FONT> <FONT COLOR="#B42318"><B>[FK]</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">batch_id <FONT COLOR="#667085">: int</FONT> <FONT COLOR="#B42318"><B>[FK]</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">purchasing_unit <FONT COLOR="#667085">: varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">purchasing_qty <FONT COLOR="#667085">: int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">subtotal <FONT COLOR="#667085">: decimal(12,2)</FONT></TD></TR></TABLE>>];
