"inventory_movements" [label=<<TABLE BORDER="1" COLOR="#98A2B3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD BGCOLOR="#FFF2CC" ALIGN="LEFT" CELLPADDING="6"><B>inventory_movements</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">movement_id <FONT COLOR="#667085">: bigint UNSIGNED</FONT> <FONT COLOR="#B42318"><B>[PK]</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">batch_id <FONT COLOR="#667085">: int</FONT> <FONT COLOR="#B42318"><B>[FK]</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">movement_type <FONT COLOR="#667085">: enum(&#x27;OPENING&#x27;,&#x27;PURCHASE_RECEIPT&#x27;,&#x27;SALE&#x27;,&#x27;SALE_CANCEL_REVERSAL&#x27;,&#x27;STOCKTAKE_GAIN&#x27;,&#x27;STOCKTAKE_LOSS&#x27;,&#x27;EXPIRED&#x27;,&#x27;SUPPLIER_RETURN&#x27;,&#x27;ADJUSTMENT&#x27;)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">source_type <FONT COLOR="#667085">: enum(&#x27;PURCHASING&#x27;,&#x27;SELLING&#x27;,&#x27;STOCK_OPNAME&#x27;,&#x27;MANUAL&#x27;,&#x27;MIGRATION&#x27;)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">source_ref <FONT COLOR="#667085">: varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">source_line_id <FONT COLOR="#667085">: varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">qty_base_change <FONT COLOR="#667085">: decimal(14,3)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">balance_after_base <FONT COLOR="#667085">: decimal(14,3)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">employee_id <FONT COLOR="#667085">: varchar(15)</FONT> <FONT COLOR="#B42318"><B>[FK]</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">event_key <FONT COLOR="#667085">: varchar(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">note <FONT COLOR="#667085">: varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3">created_at <FONT COLOR="#667085">: datetime</FONT></TD></TR></TABLE>>];
